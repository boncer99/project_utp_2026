    {
      "parameters": {
        "jsCode": "// Tiempo final\nconst tiempoFin = Date.now();\n// Tiempo inicial\nconst tiempoInicio =$('Code in JavaScript2').first().json.t_inicio\n// Latencia total\nconst latenciaTotal = tiempoFin - tiempoInicio;\n\n// Datos del Webhook\nconst estado = $(\"Webhook\").first().json.query.estado_hoja;\n\n// Datos del AI Agent\nconst ai = $(\"AI Agent\").first().json.output;\n\nlet limpio = ai\n    .replace(/```json/gi, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\nconst aiData = JSON.parse(limpio);\n\n// Datos del Google Sheets\nconst registros = $(\"Code in JavaScript1\").all().map(item => item.json);\n\n// Convertir registros a texto\nconst resumenRegistros = registros.map(r =>\n`• Estado: ${r.estado_hoja}\n  Confianza: ${r.confianza}\n  Temp: ${r.temperatura} °C\n  Humedad: ${r.humedad} %\n  Zona: ${r.zona_cultivo}\n  Fecha: ${r.fecha_hora}`\n).join(\"\\n\\n\");\n\n// Mensaje\nconst mensaje_js = `Estimado usuario,\nSe detectó la enfermedad:\n${estado}\nDescripción:\n${aiData.descripcion}\nTratamiento recomendado:\n${aiData.tratamiento}\nÚltimos registros del cultivo:\n${resumenRegistros}\n\nSe recomienda continuar monitoreando el cultivo y aplicar oportunamente las acciones descritas.\n\nSaludos cordiales.`;\nreturn [{\n    json:{\n        estado_hoja: estado,\n        descripcion: aiData.descripcion,\n        tratamiento: aiData.tratamiento,\n        ultimos_registros: registros,\n        mensaje_humano: mensaje_js,\n        // MÉTRICAS\n        latencia_total_ms: latenciaTotal,\n        latencia_total_s: (latenciaTotal/1000).toFixed(2)        \n      \n    }\n}];"
      },
